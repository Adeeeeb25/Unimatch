# UniMatch Backend Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/unimatch_db

# Port for backend API server
PORT=5001

# Secret key for student authentication JWTs (use a secure random 32+ character string in production)
JWT_SECRET=your_jwt_secret_key_here

# Secret key for Keyed HMAC OTP hashing (prevents precomputation / offline brute-force attacks)
OTP_HMAC_SECRET=your_secure_otp_hmac_secret_here

# Admin user identifier and hashed password (bcrypt hash)
ADMIN_ID=uni-admin
ADMIN_PASSWORD_HASH=$2b$12$gjAZir.Yh6HeTvHucPFd3O8Y6GwAbrxBRB4SvRobbSHjUuBRGT4LG

# Secret key for admin session JWTs
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here

# Allowed registration email domains (comma-separated list)
ALLOWED_EMAIL_DOMAINS=cuchd.in,connect.cuchd.in

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# ========================================================
# EMAIL VERIFICATION PROVIDER (Choose Option A or Option B)
# ========================================================

# --- Option A: Resend (Recommended for production delivery) ---
# Obtain an API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="UniMatch" <verify@your-verified-domain.com>

# --- Option B: SMTP (Nodemailer) ---
# Use standard SMTP or a Gmail app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# ========================================================
# OTP SECURITY & RATE LIMITING CONTROLS
# ========================================================
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
