# UniMatch Backend Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/unimatch_db

# Port for backend API server
PORT=5001

# Secret key for student authentication JWTs (use a secure random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Admin user identifier and hashed password (bcrypt hash)
ADMIN_ID=admin
ADMIN_PASSWORD_HASH=$2b$12$your_bcrypt_hash_here

# Secret key for admin session JWTs
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here

# Allowed registration email domains (comma-separated). Leave empty to allow all domains in development.
ALLOWED_EMAIL_DOMAINS=connect.university.edu,university.edu

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# Email Verification (SMTP) Configuration (Optional)
# If omitted, 6-digit OTPs are logged directly to the backend terminal console for development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="UniMatch Campus" <no-reply@unimatch.internal>
