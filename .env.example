# UniMatch Frontend Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Backend API server URL
VITE_API_URL=http://localhost:5001

# Google Maps JavaScript API Key (required for Campus Study Spots / Cafe locator map)
# Obtain an API key from Google Cloud Console with Maps JavaScript API enabled.
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
